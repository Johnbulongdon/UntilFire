      "associatedDomains": [
        "applinks:www.untilfire.com"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#003527",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.untilfire.app",
      "versionCode": 10
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 25
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FDF8F1"
        }
      ],
      "expo-web-browser",
      "expo-sharing",
      "expo-localization",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "UntilFire uses Face ID to keep your finances private."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-apple-authentication",
      [
        "@sentry/react-native/expo",
        {
          "organization": "untilfire",
          "url": "https://sentry.io/",
          "project": "untilfire-app"
        }
      ],
      "expo-secure-store",
      "expo-updates"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "4a8066dc-ad65-4ae0-9c9e-ebcc906cf72b"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/4a8066dc-ad65-4ae0-9c9e-ebcc906cf72b"
