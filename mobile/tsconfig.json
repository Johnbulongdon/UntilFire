{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // The web app's lib/ imports siblings as "./x.ts" (see ../tsconfig.json).
    "allowImportingTsExtensions": true,
    "paths": {
      // lib/fire-personality.ts imports its artwork as "@/lib/…", the web app's alias.
      "@/lib/fire-personality-art-sheet-*": ["../lib/fire-personality-art-sheet-*"],
      "@/lib/fire/tax": ["../lib/fire/tax/index.ts"],
      "@/lib/fire-data": ["../lib/fire-data.ts"],
      // The FIRE type quiz (questions, scoring, the 16 types), shared with untilfire.com/fire-type.
      "@quiz": ["../app/fire-type/quiz-data.ts"],
      "@/*": [
        "./src/*"
      ],
      "@engine/*": [
        "../lib/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ]
}