<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- Reads Google Wallet payment alerts only, after the person turns it on
         in UntilFire and in Android's notification access settings. -->
    <service
      android:name="expo.modules.walletalerts.WalletListenerService"
      android:label="UntilFire Google Pay"
      android:exported="true"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>
  </application>
</manifest>
